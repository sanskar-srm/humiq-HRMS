PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Database mode: prisma (Supabase/Postgres) or memory (local development only)
# DB_MODE=memory
# MEMORY_DATA_FILE=.data/db.json

# Supabase PostgreSQL (Prisma) - paste from Dashboard -> Project Settings -> Database -> Connect
# Use the database password (reset under Database password). NOT anon/service_role JWT keys.
# Pooler username is postgres.<project-ref> (e.g. postgres.iefbrpvshejhdititgnu).
# Special characters in the password must be URL-encoded in the URI.
# Verify: npm run db:verify
# Apply schema: npm run db:push
# Load demo data and sync the four demo identities: npm run seed

# Transaction-mode pooler (runtime / DATABASE_URL) - port 6543 + pgbouncer=true
DATABASE_URL="postgresql://postgres.iefbrpvshejhdititgnu:YOUR_DATABASE_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (migrations / DIRECT_URL) - port 5432
DIRECT_URL="postgresql://postgres.iefbrpvshejhdititgnu:YOUR_DATABASE_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

CLIENT_URL=http://localhost:5173

# Live data only: do not auto-seed on startup unless you intentionally want demo rows
AUTO_SEED=false
SEED_PASSWORD=ChangeMe123!

EMPLOYEE_REGISTRATION_CODE=
