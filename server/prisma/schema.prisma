model LmsEmployeeCertificate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificate_id String    @map("certificate_id") @db.Uuid
  employee_id    String    @map("employee_id") @db.Uuid
  issued_at      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expires_at     DateTime? @map("expires_at") @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  certificate LmsCertificate @relation(fields: [certificate_id], references: [id], onDelete: Cascade)

  @@unique([certificate_id, employee_id])
  @@map("lms_employee_certificates")
}

model LmsAnnouncement {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  body         String
  status       String    @default("Published")
  published_at DateTime? @map("published_at") @db.Timestamptz(6)
  created_by   String?   @map("created_by") @db.Uuid
  created_at   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("lms_announcements")
}
